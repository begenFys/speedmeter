# Настройки speedmeter. Скопируйте в .env и поправьте под себя.
# Флаги CLI (-n, -t) имеют приоритет над этими значениями.

# Число последовательных запросов
SPEEDMETER_COUNT=10
# Таймаут сетевой операции (соединение, ожидание данных), секунды
SPEEDMETER_TIMEOUT=30
# Ссылка на автора, добавляется в User-Agent. Без неё некоторые хосты (Wikimedia) отдают 403.
SPEEDMETER_CONTACT_URL=https://github.com/begenFys/speedmeter-ad-robot
